{
  "info": {
    "_postman_id": "fit-coach-club-api-collection-v2",
    "name": "Fit Coach Club API Collection",
    "description": "Complete Postman collection for Fit Coach Club API endpoints with base URL https://www.fitcoachclub.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://www.fitcoachclub.com",
      "type": "string"
    },
    {
      "key": "bearer_token",
      "value": "",
      "type": "string"
    }
  ],
